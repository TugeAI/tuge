# =
# SUPABASE CONFIGURATION
# =
# Récupérez ces valeurs depuis : https://supabase.com/dashboard/project/_/settings/api

# URL publique de votre projet Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique (anon key) - utilisée côté client
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role - utilisée uniquement côté serveur (API routes)
# ⚠️ NE JAMAIS exposer cette clé côté client !
SUPABASE_SERVICE_ROLE_KEY=

# =
# RESEND (Email)
# =
# Récupérez votre clé API depuis : https://resend.com/api-keys

RESEND_API_KEY=

# Email expéditeur (doit être vérifié dans Resend)
RESEND_FROM_EMAIL=

OPENAI_API_KEY=

# Client OAuth Google
IDclient=
MP=