# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cursor
.cursor/

# backup/temp files
*.old.tsx
*.old2.tsx
*.new.tsx
*.simplified.tsx
*.backup.tsx

# temp documentation files at root
*_README.md
*_RESUME.md
*_SUMMARY.md
*_COMPLETE.md
*_REFAIT.md
